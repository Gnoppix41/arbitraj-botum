{
  "compilerOptions": {
    // Hedef ve Modül
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    
    // Çıktı Ayarları
    "outDir": "./dist",
    "rootDir": "./src",
    
    // ⭐ KRİTİK: moduleResolution değişti
    "moduleResolution": "node",
    
    // Diğer ayarlar
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    
    // Hata Ayıklama
    "sourceMap": true,
    "removeComments": false,
    
    // Deprecation uyarısını sustur (isteğe bağlı)
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
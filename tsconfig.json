{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]   // 🔥 EKLE
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}